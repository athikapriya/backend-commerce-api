### ============================================================
### E-commerce API — REST Client Collection
### ============================================================

### Requirements:

### - Install the "REST Client" extension in VS Code.

### - Run the authentication requests first.

### - Copy the returned access/refresh tokens into the variables below.

### ============================================================

@baseUrl = http://127.0.0.1:8000/api

@adminToken = YOUR_ADMIN_ACCESS_TOKEN
@customerToken = YOUR_CUSTOMER_ACCESS_TOKEN
@refreshToken = YOUR_REFRESH_TOKEN

@productSlug = YOUR_PRODUCT_SLUG
@orderId = YOUR_ORDER_UUID

### ============================================================
### AUTHENTICATION
### ============================================================

### Register Customer

POST {{baseUrl}}/users/register/ HTTP/1.1
Content-Type: application/json

{
  "username": "customer",
  "email": "customer@test.com",
  "password": "StrongPassword123!",
  "confirm_password": "StrongPassword123!"
}

###

### Login (Admin)

POST {{baseUrl}}/users/login/ HTTP/1.1
Content-Type: application/json

{
  "username": "admin",
  "password": "YOUR_ADMIN_PASSWORD"
}

###

### Login (Customer)

POST {{baseUrl}}/users/login/ HTTP/1.1
Content-Type: application/json

{
  "username": "Customer1",
  "password": "YOUR_CUSTOMER_PASSWORD"
}

###

### Refresh Access Token

POST {{baseUrl}}/users/token/refresh/ HTTP/1.1
Content-Type: application/json

{
  "refresh": "{{refreshToken}}"
}

###

### Logout

POST {{baseUrl}}/users/logout/ HTTP/1.1
Authorization: Bearer {{customerToken}}
Content-Type: application/json

{
  "refresh": "{{refreshToken}}"
}

###

### Get Current User

GET {{baseUrl}}/users/profile/ HTTP/1.1
Authorization: Bearer {{customerToken}}

###

### Update Username

PATCH {{baseUrl}}/users/profile/ HTTP/1.1
Authorization: Bearer {{customerToken}}
Content-Type: application/json

{
  "username": "UserName"
}

###

### Update Email

PATCH {{baseUrl}}/users/profile/ HTTP/1.1
Authorization: Bearer {{customerToken}}
Content-Type: application/json

{
  "email": "user@example.com"
}

###

### Update Username & Email

PUT {{baseUrl}}/users/profile/ HTTP/1.1
Authorization: Bearer {{customerToken}}
Content-Type: application/json

{
  "username": "user",
  "email": "user@example.com"
}

###

### Change Password

PUT {{baseUrl}}/users/change-password/ HTTP/1.1
Authorization: Bearer {{customerToken}}
Content-Type: application/json

{
  "old_password": "OldPassword123!",
  "new_password": "NewPassword123!",
  "confirm_password": "NewPassword123!"
}

###

### Forgot Password

POST {{baseUrl}}/users/forget-password/ HTTP/1.1
Content-Type: application/json

{
  "email": "customer@test.com"
}

###

### Reset Password

POST {{baseUrl}}/users/reset-password/{{uid}}/{{token}}/ HTTP/1.1
Content-Type: application/json

{
  "new_password": "NewStrongPassword123!",
  "confirm_password": "NewStrongPassword123!"
}

###

### ============================================================
### CATEGORIES
### ============================================================

### Get all categories

GET {{baseUrl}}/categories/ HTTP/1.1

### ============================================================
### PRODUCTS - LIST, SEARCH, FILTER & PAGINATION
### ============================================================

### Get all products

GET {{baseUrl}}/products/ HTTP/1.1

###

### Search products by name

GET {{baseUrl}}/products/?search=milk HTTP/1.1

###

### Search by category name

GET {{baseUrl}}/products/?search=dairy HTTP/1.1

###

### Filter by category slug

GET {{baseUrl}}/products/?category=milk-dairy HTTP/1.1

###

### Filter by minimum price

GET {{baseUrl}}/products/?min_price=100 HTTP/1.1

###

### Filter by maximum price

GET {{baseUrl}}/products/?max_price=500 HTTP/1.1

###

### Filter by price range

GET {{baseUrl}}/products/?min_price=100&max_price=500 HTTP/1.1

###

### Products currently in stock

GET {{baseUrl}}/products/?in_stock=true HTTP/1.1

###

### Products out of stock

GET {{baseUrl}}/products/?in_stock=false HTTP/1.1

###

### Exact product name

GET {{baseUrl}}/products/?name__iexact=Milk Powder HTTP/1.1

###

### Product name contains

GET {{baseUrl}}/products/?name__icontains=milk HTTP/1.1

###

### Order by lowest price

GET {{baseUrl}}/products/?ordering=price HTTP/1.1

###

### Order by highest price

GET {{baseUrl}}/products/?ordering=-price HTTP/1.1

###

### Order by newest

GET {{baseUrl}}/products/?ordering=-created_at HTTP/1.1

###

### Order alphabetically

GET {{baseUrl}}/products/?ordering=name HTTP/1.1

###

### Pagination - Page 2

GET {{baseUrl}}/products/?page=2 HTTP/1.1

###

### Pagination - Custom page size

GET {{baseUrl}}/products/?size=5 HTTP/1.1

###

### Pagination - Page 2 with custom page size

GET {{baseUrl}}/products/?page=2&size=5 HTTP/1.1

###

### Combined filters

GET {{baseUrl}}/products/?category=milk-dairy&min_price=50&max_price=500&ordering=price HTTP/1.1

### ============================================================
### PRODUCT DETAILS
### ============================================================

### Get product by slug

GET {{baseUrl}}/products/{{productSlug}}/ HTTP/1.1

###

### Update product (Admin only)

PUT {{baseUrl}}/products/{{productSlug}}/ HTTP/1.1
Authorization: Bearer {{adminToken}}
Content-Type: application/json

{
"category": 2,
"name": "Milk",
"price": "99.00",
"stock": 120
}

###

### Partially update product (Admin only)

PATCH {{baseUrl}}/products/{{productSlug}}/ HTTP/1.1
Authorization: Bearer {{adminToken}}
Content-Type: application/json

{
"stock": 150
}

###

### Delete product (Admin only)

DELETE {{baseUrl}}/products/{{productSlug}}/ HTTP/1.1
Authorization: Bearer {{adminToken}}

### ============================================================
### ORDERS
### ============================================================

### Create Order (Customer)

POST {{baseUrl}}/orders/ HTTP/1.1
Authorization: Bearer {{customerToken}}
Content-Type: application/json

{
  "items": [
    {
      "product": 1,
      "quantity": 2
    },
    {
      "product": 5,
      "quantity": 1
    }
  ]
}

###

### List My Orders (Customer)

GET {{baseUrl}}/orders/ HTTP/1.1
Authorization: Bearer {{customerToken}}

###

### List All Orders (Admin)

GET {{baseUrl}}/orders/ HTTP/1.1
Authorization: Bearer {{adminToken}}

###

### Retrieve Order Details

GET {{baseUrl}}/orders/{{orderId}}/ HTTP/1.1
Authorization: Bearer {{customerToken}}

###

### Filter Orders by Status

GET {{baseUrl}}/orders/?status=PENDING HTTP/1.1
Authorization: Bearer {{customerToken}}

###

### Filter Orders by Created Date

GET {{baseUrl}}/orders/?created_at=2026-07-20 HTTP/1.1
Authorization: Bearer {{customerToken}}

###

### Orders Created On or After Date

GET {{baseUrl}}/orders/?created_at__gte=2026-07-01 HTTP/1.1
Authorization: Bearer {{adminToken}}

###

### Orders Created On or Before Date

GET {{baseUrl}}/orders/?created_at__lte=2026-07-31 HTTP/1.1
Authorization: Bearer {{adminToken}}

###

### Filter by Minimum Total Price

GET {{baseUrl}}/orders/?total_price__gte=500 HTTP/1.1
Authorization: Bearer {{adminToken}}

###

### Filter by Maximum Total Price

GET {{baseUrl}}/orders/?total_price__lte=2000 HTTP/1.1
Authorization: Bearer {{adminToken}}

###

### Filter by Total Price Range

GET {{baseUrl}}/orders/?total_price__gte=500&total_price__lte=2000 HTTP/1.1
Authorization: Bearer {{adminToken}}

###

### Order by Newest

GET {{baseUrl}}/orders/?ordering=-created_at HTTP/1.1
Authorization: Bearer {{customerToken}}

###

### Order by Oldest

GET {{baseUrl}}/orders/?ordering=created_at HTTP/1.1
Authorization: Bearer {{customerToken}}

###

### Order by Highest Total Price

GET {{baseUrl}}/orders/?ordering=-total_price HTTP/1.1
Authorization: Bearer {{adminToken}}

###

### Order by Lowest Total Price

GET {{baseUrl}}/orders/?ordering=total_price HTTP/1.1
Authorization: Bearer {{adminToken}}

###

### Update Order Items (Customer)
### Only works while order status is PENDING

PUT {{baseUrl}}/orders/{{orderId}}/ HTTP/1.1
Authorization: Bearer {{customerToken}}
Content-Type: application/json

{
  "items": [
    {
      "product": 2,
      "quantity": 3
    },
    {
      "product": 8,
      "quantity": 1
    }
  ]
}

###

### Partially Update Order Items (Customer)
### Only works while order status is PENDING

PATCH {{baseUrl}}/orders/{{orderId}}/ HTTP/1.1
Authorization: Bearer {{customerToken}}
Content-Type: application/json

{
  "items": [
    {
      "product": 3,
      "quantity": 2
    }
  ]
}

###

### Update Order Status (Admin Only)

PATCH {{baseUrl}}/orders/{{orderId}}/ HTTP/1.1
Authorization: Bearer {{adminToken}}
Content-Type: application/json

{
  "status": "CONFIRMED"
}

###

### Mark Order as Delivered (Admin Only)

PATCH {{baseUrl}}/orders/{{orderId}}/ HTTP/1.1
Authorization: Bearer {{adminToken}}
Content-Type: application/json

{
  "status": "DELIVERED"
}

###

### Cancel Order (Admin Only)

PATCH {{baseUrl}}/orders/{{orderId}}/ HTTP/1.1
Authorization: Bearer {{adminToken}}
Content-Type: application/json

{
  "status": "CANCELED"
}

###

### Delete Order (Admin Only)

DELETE {{baseUrl}}/orders/{{orderId}}/ HTTP/1.1
Authorization: Bearer {{adminToken}}